# Copy to .env and fill in. .env is gitignored and has never been committed.
#
# Only `forge fill --via anvil` and `forge anvil-register` need these. Every other
# command — calibrate, propose, bind, fill (local), review, bench, reuse-proof —
# works without them.
#
# Anvil authenticates with HTTP Basic: the API key is the USERNAME and the password
# is empty. See docs/03-ANVIL.md.

# From useanvil.com → Settings → API keys. Never log it, never put it in a URL,
# never include it in an error message.
ANVIL_API_KEY=your-anvil-api-key-here

# Your Anvil organisation's eid. Find it with:
#   curl -s -u "$ANVIL_API_KEY:" https://graphql.useanvil.com/ \
#        -H 'content-type: application/json' \
#        -d '{"query":"{ currentUser { organizations { eid slug name } } }"}'
ANVIL_ORG_EID=your-anvil-org-eid-here
